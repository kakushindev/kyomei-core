---
import Base from '../layouts/Base.astro';
---
<Base title="Not found · Kyōmei" noindex>
  <section class="mx-auto max-w-3xl px-5 py-24">
    <div class="dialogue">
      <h1 class="speaker">404</h1>
      <div class="box sketch" data-sketch="double">
        <p class="m-0 text-[1.3em]"><span class="type" data-typewrite="* Nothing resonates here.">* Nothing resonates here.</span></p>
        <p class="dim mb-0">The page you asked for does not exist.</p>
        <span class="continue" aria-hidden="true">▼</span>
      </div>
    </div>
    <p class="mt-8"><a class="menu-item" href="/">Back to the title screen</a></p>
  </section>
</Base>
