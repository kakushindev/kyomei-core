---
// Every claim here maps to code in Sources/. Model support is stated with its evidence.
const presets = [40, 10, 20, 20, 40, 40, 40, 20]; // "Acoustic", tenths of a dB
const bands = ['100', '200', '400', '800', '1.6k', '3.2k', '6.4k', '12.8k'];

const touch = [
  { press: 'Single tap', left: 'Play / Pause', right: 'Play / Pause' },
  { press: 'Double tap', left: 'Next track', right: 'Play / Pause' },
  { press: 'Triple tap', left: 'Previous track', right: 'Voice assistant' },
  { press: 'Press & hold', left: 'Sound mode', right: 'Sound mode' },
];

const native = [
  { item: 'Menu bar panel', note: 'battery, sound mode, EQ, quick toggles' },
  { item: 'Desktop widget', note: 'battery rings and sound mode buttons' },
  { item: 'Low battery notice', note: 'once, when a bud reaches 20%' },
  { item: 'Auto connect', note: 'on launch, on Bluetooth connect, after wake' },
  { item: 'Device switcher', note: 'every paired Soundcore device in one list' },
  { item: 'Keyboard', note: '⌘1 ⌘2 ⌘3 for modes, ⌘M to cycle, ⌘R to refresh' },
  { item: 'Open at login', note: 'with an optional Dock icon' },
  { item: 'Appearance', note: 'system, light or dark' },
];

const models = [
  { name: 'soundcore R60i NC', code: 'D1202C', status: 'Tested on hardware (firmware 03.89)' },
  { name: 'soundcore P31i', code: 'D1202', status: 'Same layout as R60i NC; not yet tested on hardware' },
  { name: 'soundcore Liberty 4 NC', code: 'A3947', status: 'Checked against recorded packets' },
  { name: 'soundcore Liberty 5', code: 'A3957', status: 'Checked against recorded packets' },
  { name: 'soundcore P40i', code: 'A3955', status: 'Checked against recorded packets' },
  { name: 'soundcore P30i / R50i NC', code: 'A3959', status: 'Checked against recorded packets' },
  { name: 'soundcore P20i / R50i / P25i', code: 'A3949', status: 'Checked against recorded packets' },
  { name: 'soundcore Space Q45', code: 'A3040', status: 'Checked against recorded packets' },
  { name: 'soundcore Space One', code: 'A3035', status: 'Checked against recorded packets' },
  { name: 'Soundcore Life Q30', code: 'A3028', status: 'Checked against recorded packets' },
  { name: 'Soundcore Life Q35', code: 'A3027', status: 'Implemented; no recordings yet' },
  { name: 'soundcore Space A40', code: 'A3936', status: 'Implemented; no recordings yet' },
  { name: 'soundcore Q20i', code: 'A3004', status: 'Implemented; no recordings yet' },
];
const max = 60;
---
<section id="features" class="mx-auto max-w-6xl px-5 py-16" aria-labelledby="features-title">
  <h2 id="features-title" class="wordmark mb-2 text-[clamp(2.2rem,1.5rem+3vw,3.5rem)]">Field notes</h2>
  <p class="dim mb-12 max-w-2xl">What Kyōmei can change on your earbuds, written down the way we worked it out. Options appear only when your model supports them.</p>

  <!-- 01 Noise: annotated diagram -->
  <article class="grid items-center gap-8 md:grid-cols-[1fr_1.1fr]" aria-labelledby="note-noise">
    <svg class="resonance w-full max-w-md justify-self-center" viewBox="0 0 320 300" role="img" aria-label="An earbud at the centre of rings, labelled with noise cancelling options" data-art="noise">
      <g fill="none" stroke="currentColor" stroke-width="2"><circle cx="160" cy="150" r="40" /><circle cx="160" cy="150" r="80" /><circle cx="160" cy="150" r="120" /></g>
    </svg>
    <div>
      <p class="dim caps text-sm">Field note 01</p>
      <h3 id="note-noise" class="wordmark mb-4 text-4xl">Noise</h3>
      <ul class="m-0 list-none space-y-3 p-0">
        <li><strong>Noise cancelling</strong>, <strong>Transparency</strong> or <strong>Normal</strong>, switched instantly.</li>
        <li><span class="dim">→</span> Adaptive, with real-time adaptation on models that offer it</li>
        <li><span class="dim">→</span> Manual strength, 1 to 5</li>
        <li><span class="dim">→</span> Scenes: transport, outdoor, indoor</li>
        <li><span class="dim">→</span> Wind noise reduction, and a hint when wind is detected</li>
        <li><span class="dim">→</span> Transparency: fully transparent or vocal</li>
      </ul>
    </div>
  </article>

  <div class="sketch my-14 h-3" data-sketch="rule" data-reroll="off" aria-hidden="true"></div>

  <!-- 02 Equalizer: a graph-paper page -->
  <article class="grid items-center gap-8 md:grid-cols-[1.1fr_1fr]" aria-labelledby="note-eq">
    <div class="md:order-2">
      <div class="sketch p-5" data-sketch="double">
        <svg class="w-full" viewBox="0 0 400 200" role="img" aria-label="Sketch of the Acoustic equalizer preset across eight bands" data-art="eq" data-values={presets.join(',')}>
          <g stroke="currentColor" stroke-opacity="0.25" stroke-dasharray="3 5">
            {bands.map((_, i) => <line x1={30 + i * 48} y1="20" x2={30 + i * 48} y2="160" />)}
            <line x1="20" y1="90" x2="380" y2="90" />
          </g>
          <polyline fill="none" stroke="currentColor" stroke-width="2.5"
            points={presets.map((v, i) => `${30 + i * 48},${90 - (v / max) * 70}`).join(' ')} data-static-curve />
          <g fill="currentColor" font-size="13" text-anchor="middle">
            {bands.map((b, i) => <text x={30 + i * 48} y="185">{b}</text>)}
          </g>
        </svg>
      </div>
    </div>
    <div class="md:order-1">
      <p class="dim caps text-sm">Field note 02</p>
      <h3 id="note-eq" class="wordmark mb-4 text-4xl">Equalizer</h3>
      <p>Eight bands from 100 Hz to 12.8 kHz, ±6 dB in half-decibel steps. Drag a band and the earbuds follow while you drag.</p>
      <p>The Soundcore presets are all there (twenty-two on the R60i NC). Save your own curves and pick them again from the menu bar.</p>
      <p class="dim text-[0.9em]">A few models only accept presets; Kyōmei shows that instead of a slider that would do nothing.</p>
    </div>
  </article>

  <div class="sketch my-14 h-3" data-sketch="rule" data-reroll="off" aria-hidden="true"></div>

  <!-- 03 Touch: a hand-ruled table -->
  <article aria-labelledby="note-touch">
    <p class="dim caps text-sm">Field note 03</p>
    <h3 id="note-touch" class="wordmark mb-4 text-4xl">Touch</h3>
    <p class="mb-6 max-w-2xl">Every gesture on each bud can be remapped: volume, tracks, play and pause, voice assistant or switching the sound mode. Restore the defaults any time.</p>
    <div class="sketch overflow-x-auto p-5" data-sketch="box">
      <table class="w-full min-w-[30rem] border-collapse text-left">
        <caption class="dim pb-3 text-left text-[0.85em]">An example layout</caption>
        <thead><tr><th scope="col" class="dim pb-2 font-normal">Gesture</th><th scope="col" class="pb-2 font-normal">Left</th><th scope="col" class="pb-2 font-normal">Right</th></tr></thead>
        <tbody>
          {touch.map((row) => (
            <tr><th scope="row" class="dim py-1.5 pr-4 font-normal">{row.press}</th><td class="py-1.5 pr-4">{row.left}</td><td class="py-1.5">{row.right}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </article>

  <div class="sketch my-14 h-3" data-sketch="rule" data-reroll="off" aria-hidden="true"></div>

  <!-- 04 Space and links: RPG choice box -->
  <article class="grid gap-10 md:grid-cols-2" aria-labelledby="note-space">
    <div>
      <p class="dim caps text-sm">Field note 04</p>
      <h3 id="note-space" class="wordmark mb-4 text-4xl">Space &amp; links</h3>
      <p>Spatial audio for music, movies or games on the R60i NC. Multipoint shows every phone and computer your earbuds remember, and connects or disconnects them from your Mac.</p>
      <p>LDAC, gaming mode, touch tones, low-battery prompts, auto power-off and a high-volume limit are there when your model has them.</p>
    </div>
    <div class="dialogue self-center">
      <p class="speaker" aria-hidden="true">Spatial audio</p>
      <div class="box sketch menu" data-sketch="double" data-menu data-menu-demo>
        <svg class="hand" viewBox="0 0 32 32" aria-hidden="true" data-hand></svg>
        <ul class="m-0 flex list-none flex-col items-start gap-1 p-0 pl-10" aria-label="Spatial audio modes (illustration)">
          <li><span class="menu-item" data-menu-item tabindex="0">Music</span></li>
          <li><span class="menu-item" data-menu-item tabindex="0">Movie</span></li>
          <li><span class="menu-item" data-menu-item tabindex="0">Gaming</span></li>
        </ul>
        <span class="continue" aria-hidden="true">▼</span>
      </div>
    </div>
  </article>

  <div class="sketch my-14 h-3" data-sketch="rule" data-reroll="off" aria-hidden="true"></div>

  <!-- 05 At home on the Mac: an inventory list -->
  <article aria-labelledby="note-native">
    <p class="dim caps text-sm">Field note 05</p>
    <h3 id="note-native" class="wordmark mb-6 text-4xl">At home on the Mac</h3>
    <ul class="m-0 grid list-none gap-x-10 gap-y-3 p-0 md:grid-cols-2">
      {native.map((n) => (
        <li class="flex items-baseline gap-3">
          <span aria-hidden="true" style="color: var(--ink)">◆</span>
          <span><strong class="font-normal caps text-[0.95em]">{n.item}</strong> <span class="dim">· {n.note}</span></span>
        </li>
      ))}
    </ul>
  </article>

  <div class="sketch my-14 h-3" data-sketch="rule" data-reroll="off" aria-hidden="true"></div>

  <!-- Supported devices, with the evidence for each -->
  <article aria-labelledby="note-devices">
    <p class="dim caps text-sm">Field note 06</p>
    <h3 id="note-devices" class="wordmark mb-4 text-4xl">Which earbuds</h3>
    <p class="mb-6 max-w-3xl">
      The protocol work stands on <a href="https://github.com/Oppzippy/OpenSCQ30" rel="noopener">OpenSCQ30</a>. Each model below is
      checked against that project's recorded packets; only the R60i NC has been tried on real hardware so far.
      If yours works (or doesn't), please tell us in an issue.
    </p>
    <div class="sketch overflow-x-auto p-5" data-sketch="box">
      <table class="w-full min-w-[34rem] border-collapse text-left">
        <thead><tr><th scope="col" class="dim pb-2 font-normal">Model</th><th scope="col" class="dim pb-2 font-normal">Code</th><th scope="col" class="dim pb-2 font-normal">Status</th></tr></thead>
        <tbody>
          {models.map((m) => (
            <tr><th scope="row" class="py-1.5 pr-4 font-normal">{m.name}</th><td class="value py-1.5 pr-4">{m.code}</td><td class="py-1.5">{m.status}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </article>
</section>
